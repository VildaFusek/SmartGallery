<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="SmartGallery.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SmartGallery">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="GalleryWorkspaceBrush" Color="#FFEAF4FF" />
                    <SolidColorBrush x:Key="GallerySurfaceBrush" Color="#FFD3E8FC" />
                    <SolidColorBrush x:Key="GalleryInsetBrush" Color="#FFE1EFFE" />
                    <SolidColorBrush x:Key="GalleryBorderBrush" Color="#FFA8C7E6" />
                    <SolidColorBrush x:Key="GallerySelectionBrush" Color="#FF087957" />
                    <SolidColorBrush x:Key="GallerySelectionFrameBrush" Color="#FFFFB000" />
                    <SolidColorBrush x:Key="GallerySelectionFrameEdgeBrush" Color="#FF172435" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="GalleryWorkspaceBrush" Color="#FF141D29" />
                    <SolidColorBrush x:Key="GallerySurfaceBrush" Color="#FF1B293A" />
                    <SolidColorBrush x:Key="GalleryInsetBrush" Color="#FF162232" />
                    <SolidColorBrush x:Key="GalleryBorderBrush" Color="#FF344A64" />
                    <SolidColorBrush x:Key="GallerySelectionBrush" Color="#FF64DAB0" />
                    <SolidColorBrush x:Key="GallerySelectionFrameBrush" Color="#FFFFD84D" />
                    <SolidColorBrush x:Key="GallerySelectionFrameEdgeBrush" Color="#FF101720" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="GalleryWorkspaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="GallerySurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="GalleryInsetBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="GalleryBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="GallerySelectionBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="GallerySelectionFrameBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="GallerySelectionFrameEdgeBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="SystemAccentColor">#FF157886</Color>
            <Color x:Key="SystemAccentColorLight1">#FF41B8B9</Color>
            <Color x:Key="SystemAccentColorLight2">#FF68D8D0</Color>
            <Color x:Key="SystemAccentColorLight3">#FF9CEBE1</Color>
            <Color x:Key="SystemAccentColorDark1">#FF006477</Color>
            <Color x:Key="SystemAccentColorDark2">#FF005663</Color>
            <Color x:Key="SystemAccentColorDark3">#FF003F49</Color>
            <Style x:Key="GallerySurfaceStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource GallerySurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource GalleryBorderBrush}" />
            </Style>
            <Style x:Key="GalleryCardStyle" TargetType="Border" BasedOn="{StaticResource GallerySurfaceStyle}">
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="GalleryInsetStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource GalleryInsetBrush}" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
            <Style x:Key="GalleryWorkspaceStyle" TargetType="Grid">
                <Setter Property="Background" Value="{ThemeResource GalleryWorkspaceBrush}" />
            </Style>
            <Style x:Key="GallerySecondaryTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="12" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
