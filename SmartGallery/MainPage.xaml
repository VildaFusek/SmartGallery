<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SmartGallery.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:catalog="using:SmartGallery.Application.Catalog"
    xmlns:local="using:SmartGallery"
    xmlns:vm="using:SmartGallery.ViewModels"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

    <Page.Resources>
        <CollectionViewSource x:Key="TimelineSource" IsSourceGrouped="True" />
        <Style x:Key="MediaItemContainerStyle" TargetType="GridViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4" />
        </Style>
        <Style x:Key="MediaSelectionFrameStyle" TargetType="ContentControl">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border BorderBrush="{ThemeResource GallerySelectionFrameEdgeBrush}"
                                BorderThickness="2" CornerRadius="8">
                            <Border BorderBrush="{ThemeResource GallerySelectionFrameBrush}"
                                    BorderThickness="4" CornerRadius="6" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GallerySelectionCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="UncheckedPointerOver" />
                                    <VisualState x:Name="UncheckedPressed" />
                                    <VisualState x:Name="UncheckedDisabled" />
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="CheckedFace.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="CheckedFace.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="CheckedFace.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedDisabled">
                                        <VisualState.Setters>
                                            <Setter Target="CheckedFace.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border Background="{ThemeResource GallerySelectionFrameEdgeBrush}"
                                    BorderBrush="{ThemeResource GallerySelectionFrameBrush}"
                                    BorderThickness="2" CornerRadius="6" />
                            <Border x:Name="CheckedFace" Opacity="0" IsHitTestVisible="False"
                                    Background="{ThemeResource GallerySelectionFrameBrush}"
                                    BorderBrush="{ThemeResource GallerySelectionFrameEdgeBrush}"
                                    BorderThickness="2" CornerRadius="6">
                                <Path Width="20" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M 2,9 L 8,15 L 19,3" Stroke="{ThemeResource GallerySelectionFrameEdgeBrush}"
                                      StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MarqueeOutlineStyle" TargetType="Rectangle">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="{ThemeResource GallerySelectionBrush}" />
            <Setter Property="Fill">
                <Setter.Value>
                    <SolidColorBrush Color="{ThemeResource SystemAccentColor}" Opacity="0.18" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MediaBadgeStyle" TargetType="Border">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="MediaBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="MediaBadgeRowStyle" TargetType="Grid">
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="ColumnSpacing" Value="4" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <ItemsPanelTemplate x:Key="DuplicateReviewPanel">
            <ItemsWrapGrid Orientation="Horizontal" GroupHeaderPlacement="Top" AreStickyGroupHeadersEnabled="True" />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="DuplicateReviewGroupHeader" x:DataType="vm:DuplicateReviewGroup">
            <Border Padding="4,8,4,4" Background="{ThemeResource GalleryWorkspaceBrush}">
                <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="DuplicateReviewTemplate" x:DataType="vm:DuplicateReviewTile">
            <StackPanel Width="140" Padding="6" Spacing="4"
                        ToolTipService.ToolTip="{x:Bind File.RelativePath}" AutomationProperties.Name="{x:Bind AutomationLabel}">
                <Grid Height="100">
                    <TextBlock x:Name="ReviewPlaceholder" Text="Bez náhledu"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image x:Name="ReviewThumbnail" Stretch="Uniform" Unloaded="OnFileVisualUnloaded" />
                    <Grid Style="{StaticResource MediaBadgeRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border HorizontalAlignment="Left" Style="{StaticResource MediaBadgeStyle}">
                            <TextBlock Text="{x:Bind local:ThumbnailMetadata.FormatExtension(File.Name)}"
                                       Style="{StaticResource MediaBadgeTextStyle}" />
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource MediaBadgeStyle}">
                            <TextBlock Text="{x:Bind local:ThumbnailMetadata.FormatSize(File.SizeBytes)}"
                                       Style="{StaticResource MediaBadgeTextStyle}" />
                        </Border>
                    </Grid>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon x:Name="KeeperCheck" x:Load="{x:Bind Keep}" Glyph="&#xE73E;" FontSize="12"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="{x:Bind Status}" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock Text="{x:Bind File.Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind File.Folder}" TextTrimming="CharacterEllipsis" FontSize="12" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="TrashReviewTemplate" x:DataType="vm:TrashReviewRow">
            <Grid Width="164" AutomationProperties.Name="{x:Bind Item.RelativePath}"
                  ToolTipService.ToolTip="{x:Bind Item.RelativePath}">
                <Border Padding="6" Style="{StaticResource GalleryCardStyle}">
                    <StackPanel Spacing="6">
                        <Border Style="{StaticResource GalleryInsetStyle}">
                            <Grid Height="110">
                                <FontIcon x:Name="ReviewPlaceholder" Glyph="&#xE91B;" FontSize="22" />
                                <Image x:Name="ReviewThumbnail" Stretch="Uniform" Unloaded="OnFileVisualUnloaded" />
                                <Grid Style="{StaticResource MediaBadgeRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border HorizontalAlignment="Left" Style="{StaticResource MediaBadgeStyle}">
                                        <TextBlock Text="{x:Bind local:ThumbnailMetadata.FormatExtension(Name)}"
                                                   Style="{StaticResource MediaBadgeTextStyle}" />
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource MediaBadgeStyle}">
                                        <TextBlock Text="{x:Bind local:ThumbnailMetadata.FormatSize(Item.SizeBytes)}"
                                                   Style="{StaticResource MediaBadgeTextStyle}" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                        <TextBlock Text="{x:Bind Name}" TextAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" />
                        <TextBlock Text="{x:Bind TrashedAtLabel}" TextAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="11" />
                    </StackPanel>
                </Border>
                <ContentControl Style="{StaticResource MediaSelectionFrameStyle}"
                                Loaded="OnSelectionFrameLoaded" Unloaded="OnSelectionFrameUnloaded" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ThumbnailTemplate" x:DataType="catalog:GalleryFile">
            <Grid ToolTipService.ToolTip="{x:Bind Name}" AutomationProperties.Name="{x:Bind Name}">
                <Border Style="{StaticResource GalleryCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource GalleryInsetStyle}">
                            <Grid>
                                <FontIcon Glyph="&#xE91B;" FontSize="22" />
                                <Image x:Name="TileThumbnail" Stretch="Uniform"
                                        Loaded="OnFileVisualLoaded" Unloaded="OnFileVisualUnloaded" />
                                <ContentControl x:Name="TileVideoHost" Visibility="Collapsed" IsHitTestVisible="False"
                                                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                                <Grid Style="{StaticResource MediaBadgeRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border HorizontalAlignment="Left" Style="{StaticResource MediaBadgeStyle}">
                                        <TextBlock Text="{x:Bind local:ThumbnailMetadata.FormatExtension(Name)}"
                                                   Style="{StaticResource MediaBadgeTextStyle}" />
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource MediaBadgeStyle}">
                                        <TextBlock Text="{x:Bind local:ThumbnailMetadata.FormatSize(SizeBytes)}"
                                                   Style="{StaticResource MediaBadgeTextStyle}" />
                                    </Border>
                                </Grid>
                                <Border x:Name="AnalysisBadge" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                        Margin="4" Visibility="Collapsed" Style="{StaticResource MediaBadgeStyle}"
                                        AutomationProperties.Name="Analyzováno AI">
                                    <TextBlock Text="AI" Style="{StaticResource MediaBadgeTextStyle}" />
                                </Border>
                            </Grid>
                        </Border>
                         <HyperlinkButton Grid.Row="1" Padding="6,4" HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch" Click="OnFileNameClick"
                                          AutomationProperties.Name="{x:Bind Name}" ToolTipService.ToolTip="Přejmenovat soubor">
                             <TextBlock Text="{x:Bind Name}" TextAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" />
                         </HyperlinkButton>
                    </Grid>
                </Border>
                <ContentControl Style="{StaticResource MediaSelectionFrameStyle}"
                                Loaded="OnSelectionFrameLoaded" Unloaded="OnSelectionFrameUnloaded" />
                <CheckBox Style="{StaticResource GallerySelectionCheckBoxStyle}"
                          VerticalAlignment="Bottom" Margin="8,0,8,28"
                          AutomationProperties.Name="{x:Bind Name}"
                          Loaded="OnSelectionCheckBoxLoaded" Unloaded="OnSelectionCheckBoxUnloaded" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="DetailsTemplate" x:DataType="catalog:GalleryFile">
            <Grid x:Name="FileDetails"
                  Loaded="OnFileVisualLoaded" Unloaded="OnFileVisualUnloaded"
                  AutomationProperties.Name="{x:Bind Name}">
                <Grid Padding="8,6,48,6" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border MinWidth="52" Padding="4" VerticalAlignment="Center"
                            Style="{StaticResource GalleryInsetStyle}">
                        <StackPanel Spacing="2">
                            <FontIcon Glyph="&#xE8A5;" FontSize="16" />
                            <TextBlock x:Name="ExtensionBadge" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1">
                         <HyperlinkButton Padding="0" Click="OnFileNameClick" AutomationProperties.Name="{x:Bind Name}"
                                          ToolTipService.ToolTip="Přejmenovat soubor">
                             <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                         </HyperlinkButton>
                        <TextBlock Text="{x:Bind RelativePath}" Style="{StaticResource GallerySecondaryTextStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{x:Bind RelativePath}" />
                        <TextBlock x:Name="FileMetadata" Style="{StaticResource GallerySecondaryTextStyle}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="MediaMetadata" Style="{StaticResource GallerySecondaryTextStyle}"
                                   MinHeight="16" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border x:Name="AnalysisBadge" Grid.Column="2" VerticalAlignment="Center"
                            Visibility="Collapsed" Style="{StaticResource MediaBadgeStyle}"
                            AutomationProperties.Name="Analyzováno AI">
                        <TextBlock Text="AI" Style="{StaticResource MediaBadgeTextStyle}" />
                    </Border>
                </Grid>
                <ContentControl Style="{StaticResource MediaSelectionFrameStyle}"
                                Loaded="OnSelectionFrameLoaded" Unloaded="OnSelectionFrameUnloaded" />
                <CheckBox Style="{StaticResource GallerySelectionCheckBoxStyle}"
                          AutomationProperties.Name="{x:Bind Name}"
                          Loaded="OnSelectionCheckBoxLoaded" Unloaded="OnSelectionCheckBoxUnloaded" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid x:Name="GalleryWorkspace" Style="{StaticResource GalleryWorkspaceStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="16,10" Background="{ThemeResource GallerySurfaceBrush}">
            <StackPanel Spacing="8">
                <MenuBar>
                    <MenuBarItem Title="Soubor">
                        <MenuFlyoutItem Text="Importovat složku…" Command="{x:Bind ViewModel.ImportCommand}">
                            <MenuFlyoutItem.Icon><SymbolIcon Symbol="Add" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Aktualizovat" Command="{x:Bind ViewModel.ReloadCommand}">
                            <MenuFlyoutItem.Icon><SymbolIcon Symbol="Refresh" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuBarItem>
                    <MenuBarItem Title="Úpravy">
                        <ToggleMenuFlyoutItem x:Name="MultiSelectToggle" Text="Označit více" Click="OnMultiSelectClick"
                                              IsEnabled="{x:Bind ViewModel.CanBrowse, Mode=OneWay}" />
                        <MenuFlyoutItem Text="Přesunout označené do koše" Click="OnDeleteClick"
                                        IsEnabled="{x:Bind ViewModel.CanDelete, Mode=OneWay}"
                                        KeyboardAcceleratorTextOverride="Delete">
                            <MenuFlyoutItem.Icon><SymbolIcon Symbol="Delete" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Trvale smazat označené…" Click="OnDeletePermanentlyClick"
                                        IsEnabled="{x:Bind ViewModel.CanDelete, Mode=OneWay}"
                                        KeyboardAcceleratorTextOverride="Shift+Delete" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Obnovit vybrané z koše" Click="OnRestoreTrashClick"
                                        IsEnabled="{x:Bind ViewModel.CanRestoreTrash, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><SymbolIcon Symbol="Undo" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Vysypat koš…" Click="OnEmptyTrashClick"
                                        IsEnabled="{x:Bind ViewModel.CanEmptyTrash, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><SymbolIcon Symbol="Delete" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuBarItem>
                    <MenuBarItem Title="Zobrazení">
                        <ToggleMenuFlyoutItem x:Name="DetailsToggle" Text="Podrobnosti" Click="OnDetailsClick"
                                              IsEnabled="{x:Bind ViewModel.CanBrowse, Mode=OneWay}"
                                              KeyboardAcceleratorTextOverride="Alt+Enter" />
                        <MenuFlyoutSubItem Text="Velikost miniatur" IsEnabled="{x:Bind ViewModel.CanBrowse, Mode=OneWay}">
                            <RadioMenuFlyoutItem Text="Výchozí velikost" GroupName="GalleryThumbnailSize" Tag="100"
                                                 IsChecked="True" Click="OnThumbnailSizeClick" />
                            <RadioMenuFlyoutItem Text="Zvětšit o 50 %" GroupName="GalleryThumbnailSize" Tag="150"
                                                 Click="OnThumbnailSizeClick" />
                            <RadioMenuFlyoutItem Text="Zvětšit o 100 %" GroupName="GalleryThumbnailSize" Tag="200"
                                                 Click="OnThumbnailSizeClick" />
                            <RadioMenuFlyoutItem Text="Zvětšit o 150 %" GroupName="GalleryThumbnailSize" Tag="250"
                                                 Click="OnThumbnailSizeClick" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSubItem Text="Motiv aplikace">
                            <RadioMenuFlyoutItem Text="Světlý" GroupName="GalleryTheme" Tag="Light" Click="OnThemeClick" />
                            <RadioMenuFlyoutItem Text="Tmavý" GroupName="GalleryTheme" Tag="Dark" Click="OnThemeClick" />
                            <RadioMenuFlyoutItem Text="Podle Windows" GroupName="GalleryTheme" Tag="Default"
                                                 IsChecked="True" Click="OnThemeClick" />
                        </MenuFlyoutSubItem>
                    </MenuBarItem>
                      <MenuBarItem Title="Nástroje">
                         <MenuFlyoutItem Text="Analýza galerie…" Click="OnAnalysisWindowClick">
                             <MenuFlyoutItem.Icon><SymbolIcon Symbol="Find" /></MenuFlyoutItem.Icon>
                         </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Popsat výběr" Command="{x:Bind ViewModel.DescribeSelectionCommand}">
                            <MenuFlyoutItem.Icon><SymbolIcon Symbol="Comment" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Použít návrhy názvů…" Click="OnApplyGalleryNamesClick"
                                        IsEnabled="{x:Bind ViewModel.CanApplyGalleryNames, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><SymbolIcon Symbol="Rename" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuBarItem>
                    <MenuBarItem Title="Nápověda">
                        <MenuFlyoutItem Text="Klávesové zkratky a koš…" Click="OnHelpClick">
                            <MenuFlyoutItem.Icon><SymbolIcon Symbol="Help" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuBarItem>
                </MenuBar>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                     <Button Padding="10,6" AllowDrop="True"
                            DragOver="OnImportDragOver" Drop="OnImportDrop"
                            Command="{x:Bind ViewModel.ImportCommand}" Style="{StaticResource AccentButtonStyle}"
                            AutomationProperties.Name="Importovat složku"
                            ToolTipService.ToolTip="Klikni nebo sem přetáhni složku. Originály se nemění.">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <SymbolIcon Symbol="Add" />
                             <TextBlock Text="Importovat složku…" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                     <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                             Padding="4,0" CornerRadius="6" Background="#FFF5F7FF"
                             Visibility="{x:Bind ViewModel.IsGalleryOpen, Mode=OneWay}">
                         <Image Width="120" Height="38" Stretch="Uniform" AutomationProperties.Name="SmartGallery">
                             <Image.Source>
                                 <BitmapImage UriSource="ms-appx:///Assets/Logo_main.png" DecodePixelWidth="360" />
                             </Image.Source>
                         </Image>
                     </Border>
                     <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"
                                VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind ViewModel.IsTrashOpen, Mode=OneWay}" />
                     <Button Grid.Column="2" VerticalAlignment="Center" ToolTipService.ToolTip="Nastavení importu">
                         <Button.Flyout>
                                 <Flyout Placement="Bottom">
                                     <ScrollViewer MaxWidth="440" MaxHeight="420" VerticalScrollBarVisibility="Auto">
                                         <StackPanel Spacing="8" Padding="0,0,8,0">
                                        <TextBlock Text="{x:Bind ViewModel.LibrarySummary, Mode=OneWay}" TextWrapping="Wrap"
                                                   IsTextSelectionEnabled="True" FontSize="12" />
                                        <Button Content="Nastavit cílovou složku" Command="{x:Bind ViewModel.ChooseLibraryCommand}" />
                                        <ComboBox Header="Struktura fotografií" HorizontalAlignment="Stretch"
                                                  SelectedIndex="{x:Bind ViewModel.SelectedLayoutIndex, Mode=TwoWay}"
                                                  IsEnabled="{x:Bind ViewModel.CanEditImportSettings, Mode=OneWay}">
                                            <ComboBoxItem Content="Rok \ měsíc (doporučeno)" />
                                            <ComboBoxItem Content="Rok \ den" />
                                            <ComboBoxItem Content="Zachovat zdrojové podadresáře" />
                                        </ComboBox>
                                        <ComboBox Header="Pojmenování kopií" HorizontalAlignment="Stretch"
                                                  SelectedIndex="{x:Bind ViewModel.SelectedNamingIndex, Mode=TwoWay}"
                                                  IsEnabled="{x:Bind ViewModel.CanEditImportSettings, Mode=OneWay}">
                                            <ComboBoxItem Content="Zachovat původní název" />
                                            <ComboBoxItem Content="Datum + původní název" />
                                        </ComboBox>
                                        <TextBlock Text="{x:Bind ViewModel.StageMessage}" TextWrapping="Wrap" FontSize="12" />
                                        <TextBlock Text="Modelové příklady relativních cest:" FontSize="12" />
                                        <TextBlock Text="{x:Bind ViewModel.ExampleRelativePath, Mode=OneWay}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind ViewModel.ExampleVideoRelativePath, Mode=OneWay}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind ViewModel.ImportSettingsMessage, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" />
                                        <Button Content="Uložit pravidla" Command="{x:Bind ViewModel.SaveImportSettingsCommand}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Flyout>
                         </Button.Flyout>
                         <StackPanel Orientation="Horizontal" Spacing="6">
                             <SymbolIcon Symbol="Setting" />
                             <TextBlock Text="Nastavení" />
                         </StackPanel>
                    </Button>
                         <Button x:Name="RequiredFilesButton" Grid.Column="3" VerticalAlignment="Center"
                                 ToolTipService.ToolTip="{x:Bind FooterViewModel.Message, Mode=OneWay}">
                             <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <ScrollViewer MaxWidth="440" MaxHeight="420" VerticalScrollBarVisibility="Auto">
                                         <StackPanel Spacing="8" Padding="0,0,8,0">
                                             <TextBlock Text="Potřebné soubory" FontWeight="SemiBold" FontSize="18" />
                                             <TextBlock Text="Model AI · Florence-2" FontWeight="SemiBold" />
                                             <TextBlock Text="{x:Bind FooterViewModel.Modules.Summary, Mode=OneWay}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind FooterViewModel.RuntimeStatus, Mode=OneWay}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind FooterViewModel.Message, Mode=OneWay}" TextWrapping="Wrap" />
                                            <ProgressBar Maximum="100" Value="{x:Bind FooterViewModel.Progress, Mode=OneWay}"
                                                         IsIndeterminate="{x:Bind FooterViewModel.IsIndeterminate, Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind FooterViewModel.Counts, Mode=OneWay}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="Zastavit přípravu" Command="{x:Bind FooterViewModel.CancelCommand}" />
                                                 <Button Content="Připravit model…" Click="OnAiDownloadClick"
                                                         IsEnabled="{x:Bind FooterViewModel.CanPrepareModel, Mode=OneWay}" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.LocalModelDirectory}" TextWrapping="Wrap"
                                                       IsTextSelectionEnabled="True" FontSize="12" />
                                            <Button Content="Podrobná kontrola souborů modelu" Command="{x:Bind ViewModel.VerifyModelCommand}" />
                                            <TextBlock Text="{x:Bind ViewModel.ModelCheckSummary, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" />
                                             <Button Content="Vygenerovat popisek fotografie…" Command="{x:Bind ViewModel.CaptionCommand}" />
                                             <TextBlock Text="Video · FFmpeg, FFprobe a FFplay" FontWeight="SemiBold" Margin="0,12,0,0" />
                                             <TextBlock Text="{x:Bind FooterViewModel.VideoSetupMessage, Mode=OneWay}" TextWrapping="Wrap" />
                                             <ProgressBar Value="{x:Bind FooterViewModel.VideoSetupProgress, Mode=OneWay}"
                                                          IsIndeterminate="{x:Bind FooterViewModel.VideoSetupIndeterminate, Mode=OneWay}"
                                                          Visibility="{x:Bind FooterViewModel.VideoSetupActive, Mode=OneWay}" />
                                             <StackPanel Orientation="Horizontal" Spacing="8">
                                                 <Button Content="Stáhnout FFmpeg…" Click="OnVideoInstallClick"
                                                         IsEnabled="{x:Bind FooterViewModel.CanDownloadVideoTools, Mode=OneWay}" />
                                                 <Button Content="Zastavit" Click="OnCancelVideoToolsClick"
                                                         IsEnabled="{x:Bind FooterViewModel.VideoSetupActive, Mode=OneWay}" />
                                             </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Flyout>
                             </Button.Flyout>
                             <StackPanel Orientation="Horizontal" Spacing="6">
                                 <SymbolIcon Symbol="Library" />
                                 <TextBlock Text="Potřebné soubory" />
                             </StackPanel>
                        </Button>
                         <Button Grid.Column="4" Click="OnCancelGalleryWorkClick" VerticalAlignment="Center"
                                 Visibility="{x:Bind ViewModel.GalleryWorkActive, Mode=OneWay}"
                                 AutomationProperties.Name="Zastavit práci s galerií" ToolTipService.ToolTip="Zastavit">
                             <SymbolIcon Symbol="Stop" />
                         </Button>
                         <ProgressRing Grid.Column="5" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="18" Height="18" />
                 </Grid>
                  <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.IsGalleryOpen, Mode=OneWay}">
                     <Grid.ColumnDefinitions>
                         <ColumnDefinition Width="*" />
                         <ColumnDefinition Width="Auto" />
                         <ColumnDefinition Width="Auto" />
                         <ColumnDefinition Width="Auto" />
                         <ColumnDefinition Width="Auto" />
                         <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                     <TextBox PlaceholderText="Hledat v galerii…"
                              AutomationProperties.Name="Hledat v galerii"
                              ToolTipService.ToolTip="Hledá všechna zadaná slova v názvu, cestě, datu na časové ose a popisku či návrhu AI. Na diakritice nezáleží."
                               Text="{x:Bind ViewModel.NameFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               IsEnabled="{x:Bind ViewModel.CanBrowse, Mode=OneWay}" />
                     <ComboBox Grid.Column="1" MinWidth="110" AutomationProperties.Name="Typ média"
                                IsEnabled="{x:Bind ViewModel.CanBrowse, Mode=OneWay}"
                                SelectedIndex="{x:Bind ViewModel.MediaFilterIndex, Mode=TwoWay}">
                         <ComboBoxItem Content="Všechna média" />
                        <ComboBoxItem Content="Fotografie" />
                        <ComboBoxItem Content="Videa" />
                     </ComboBox>
                      <ComboBox Grid.Column="2" AutomationProperties.Name="Přípona souboru"
                                 IsEnabled="{x:Bind ViewModel.CanBrowse, Mode=OneWay}"
                                 ItemsSource="{x:Bind ViewModel.ExtensionOptions, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.ExtensionFilter, Mode=TwoWay}" />
                      <ComboBox Grid.Column="3" AutomationProperties.Name="Seřazení"
                                 IsEnabled="{x:Bind ViewModel.CanBrowse, Mode=OneWay}"
                                 SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}"
                                ToolTipService.ToolTip="Mimo časovou osu se řadí celá galerie. U videí se použije dostupné datum z metadat (může jít o datum kódování).">
                          <ComboBoxItem Content="Časová osa" />
                          <ComboBoxItem Content="Název: A–Ž" />
                          <ComboBoxItem Content="Název: Ž–A" />
                          <ComboBoxItem Content="Velikost: největší" />
                          <ComboBoxItem Content="Velikost: nejmenší" />
                          <ComboBoxItem Content="Pořízení: nejnovější" />
                          <ComboBoxItem Content="Pořízení: nejstarší" />
                      </ComboBox>
                      <ComboBox Grid.Column="4" MinWidth="140" AutomationProperties.Name="Stav analýzy"
                                IsEnabled="{x:Bind ViewModel.CanBrowse, Mode=OneWay}"
                                SelectedIndex="{x:Bind ViewModel.AnalysisFilterIndex, Mode=TwoWay}">
                         <ComboBoxItem Content="Všechny stavy AI" />
                         <ComboBoxItem Content="Analyzované" />
                         <ComboBoxItem Content="Neanalyzované fotky" />
                         <ComboBoxItem Content="Čeká na přejmenování" />
                      </ComboBox>
                       <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8">
                           <Button Content="Do koše…" Click="OnDeleteClick" ToolTipService.ToolTip="Delete"
                                   IsEnabled="{x:Bind ViewModel.CanDelete, Mode=OneWay}" />
                           <Button Content="Trvale smazat…" Click="OnDeletePermanentlyClick"
                                   ToolTipService.ToolTip="Shift+Delete"
                                   IsEnabled="{x:Bind ViewModel.CanDelete, Mode=OneWay}" />
                       </StackPanel>
                 </Grid>
                 <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.IsGalleryOpen, Mode=OneWay}">
                 <Button x:Name="SelectionPhotoConvert" Content="Převést vybrané fotografie…" Visibility="Collapsed"
                         IsEnabled="{x:Bind ViewModel.CanChangeFilters, Mode=OneWay}" Click="OnSelectionPhotoConvert" />
                 <Button x:Name="SelectionPhotoCancel" Content="Zastavit úlohu" Visibility="Collapsed"
                         Click="OnSelectionPhotoCancel" />
                 </StackPanel>
                 <Border x:Name="VideoSelectionBar" Visibility="Collapsed" Padding="12,8"
                         Style="{StaticResource GalleryCardStyle}">
                     <StackPanel Spacing="6">
                         <Grid ColumnSpacing="12">
                             <Grid.ColumnDefinitions>
                                 <ColumnDefinition Width="Auto" />
                                 <ColumnDefinition Width="*" />
                             </Grid.ColumnDefinitions>
                             <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                 <SymbolIcon Symbol="Video" />
                                  <HyperlinkButton x:Name="VideoSelectionTitle" Padding="0" FontWeight="SemiBold"
                                                   Click="OnFileNameClick" ToolTipService.ToolTip="Přejmenovat vybrané video" />
                             </StackPanel>
                             <ComboBox x:Name="VideoSelectionPicker" Grid.Column="1" DisplayMemberPath="Name"
                                       HorizontalAlignment="Left" MaxWidth="380" SelectionChanged="OnVideoSelectionPicked"
                                       AutomationProperties.Name="Video z výběru" />
                         </Grid>
                         <TextBlock x:Name="VideoSelectionStatus" TextWrapping="Wrap"
                                    Style="{StaticResource GallerySecondaryTextStyle}"
                                    ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                         <TextBlock x:Name="VideoSelectionResult" TextTrimming="CharacterEllipsis" Visibility="Collapsed"
                                    ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                         <StackPanel Orientation="Horizontal" Spacing="8">
                             <Button x:Name="SelectionVideoInstall" Content="Stáhnout FFmpeg…" Click="OnVideoInstallClick" />
                             <Button x:Name="SelectionVideoPlay" Content="Přehrát v miniatuře" Click="OnSelectionVideoPlay" />
                             <Button x:Name="SelectionVideoWindow" Content="Zvětšit" Click="OnSelectionVideoWindow" />
                             <Button x:Name="SelectionVideoPause" Content="Pozastavit / pokračovat" Click="OnSelectionVideoPause" />
                             <Button x:Name="SelectionVideoStop" Content="Zastavit přehrávání" Click="OnSelectionVideoStop" />
                             <Button x:Name="SelectionVideoConvert" Content="Převést video…" Click="OnSelectionVideoConvert" />
                              <Button x:Name="SelectionVideoBatch" Content="Převést vybraná videa…" Click="OnSelectionVideoBatch" />
                             <Button x:Name="SelectionVideoCancel" Content="Zastavit" Click="OnSelectionVideoCancel" />
                         </StackPanel>
                          <ProgressBar x:Name="SelectionVideoProgress" Visibility="Collapsed" />
                          <StackPanel x:Name="ConversionFilePanel" Spacing="4" Visibility="Collapsed">
                              <TextBlock x:Name="ConversionFileDetail" TextWrapping="Wrap" />
                              <ProgressBar x:Name="ConversionFileProgress" />
                          </StackPanel>
                     </StackPanel>
                 </Border>
             </StackPanel>
        </Border>

        <Grid Grid.Row="1" ColumnSpacing="12" Margin="12">
            <Grid.Resources>
                <Thickness x:Key="GridViewItemSelectedBorderThickness">1</Thickness>
                <CornerRadius x:Key="GridViewItemCornerRadius">8</CornerRadius>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Padding="4,8" Style="{StaticResource GalleryCardStyle}">
                <TreeView x:Name="FolderTree" SelectionMode="Single" ItemInvoked="OnFolderInvoked"
                          Expanding="OnFolderExpanding" AutomationProperties.Name="Navigace časovou osou"
                          IsEnabled="{x:Bind ViewModel.CanNavigateLibrary, Mode=OneWay}">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <DataTemplate x:DataType="TreeViewNode">
                            <Grid MinHeight="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ((vm:GalleryFolder)Content).Name}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind ((vm:GalleryFolder)Content).Name}" />
                                <StackPanel x:Name="PhotoCountBadge" x:Load="{x:Bind ((vm:GalleryFolder)Content).HasPhotos}"
                                            Grid.Column="1" Orientation="Horizontal" Spacing="3" Margin="6,0,0,0"
                                            VerticalAlignment="Center" ToolTipService.ToolTip="Počet fotografií">
                                    <Viewbox Width="14" Height="14">
                                        <SymbolIcon Symbol="Pictures" />
                                    </Viewbox>
                                    <TextBlock Text="{x:Bind ((vm:GalleryFolder)Content).PhotoCount}" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel x:Name="VideoCountBadge" x:Load="{x:Bind ((vm:GalleryFolder)Content).HasVideos}"
                                            Grid.Column="2" Orientation="Horizontal" Spacing="3" Margin="6,0,0,0"
                                            VerticalAlignment="Center" ToolTipService.ToolTip="Počet videí">
                                    <Viewbox Width="14" Height="14">
                                        <SymbolIcon Symbol="Video" />
                                    </Viewbox>
                                    <TextBlock Text="{x:Bind ((vm:GalleryFolder)Content).VideoCount}" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>

             <Grid x:Name="GalleryHost" Grid.Column="1" Background="Transparent" SizeChanged="OnGalleryHostSizeChanged"
                   Visibility="{x:Bind ViewModel.IsGalleryOpen, Mode=OneWay}">
            <GridView x:Name="GalleryGrid" SelectionMode="Extended" IsMultiSelectCheckBoxEnabled="False"
                      Background="Transparent"
                      ItemsSource="{Binding Source={StaticResource TimelineSource}}"
                      ItemTemplate="{StaticResource ThumbnailTemplate}"
                      ItemContainerStyle="{StaticResource MediaItemContainerStyle}"
                      SelectionChanged="OnMediaSelectionChanged"
                      ContainerContentChanging="OnTileChanging"
                      AutomationProperties.Name="Časová osa médií">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" GroupHeaderPlacement="Top"
                                       AreStickyGroupHeadersEnabled="True" Loaded="OnGalleryPanelLoaded" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderContainerStyle>
                            <Style TargetType="GridViewHeaderItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </GroupStyle.HeaderContainerStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate x:DataType="vm:GalleryTimelineGroup">
                                <StackPanel Padding="4,4,12,4" Spacing="4"
                                            Background="{ThemeResource GalleryWorkspaceBrush}">
                                    <Border x:Load="{x:Bind StartsYear}" x:Name="YearSeparator"
                                            BorderThickness="0,0,0,2"
                                            BorderBrush="{ThemeResource AccentTextFillColorPrimaryBrush}">
                                        <TextBlock Text="{x:Bind YearLabel}" Style="{StaticResource SubtitleTextBlockStyle}"
                                                   AutomationProperties.HeadingLevel="Level1" Margin="0,0,0,4" />
                                    </Border>
                                    <Border BorderThickness="0,0,0,1"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                        <TextBlock Text="{x:Bind SectionLabel}" FontWeight="SemiBold"
                                                   AutomationProperties.HeadingLevel="Level2" Margin="0,0,0,4" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </GridView.GroupStyle>
            </GridView>
             <Canvas IsHitTestVisible="False">
                 <Rectangle x:Name="SelectionRectangle" Style="{StaticResource MarqueeOutlineStyle}" />
            </Canvas>
             </Grid>
            <Grid Grid.Column="1" RowSpacing="8" Visibility="{x:Bind ViewModel.IsTrashOpen, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.TrashSummary, Mode=OneWay}" VerticalAlignment="Center" />
                    <Button Click="OnRestoreTrashClick" IsEnabled="{x:Bind ViewModel.CanRestoreTrash, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Undo" />
                            <TextBlock Text="Obnovit vybrané" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnEmptyTrashClick" IsEnabled="{x:Bind ViewModel.CanEmptyTrash, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Delete" />
                            <TextBlock Text="Vysypat koš…" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Grid x:Name="TrashHost" Grid.Row="1" Background="Transparent">
                    <GridView x:Name="TrashGrid" ItemsSource="{x:Bind ViewModel.TrashItems, Mode=OneWay}"
                              ItemTemplate="{StaticResource TrashReviewTemplate}" SelectionMode="Extended"
                              ItemContainerStyle="{StaticResource MediaItemContainerStyle}"
                              IsMultiSelectCheckBoxEnabled="True" SelectionChanged="OnMediaSelectionChanged"
                              ContainerContentChanging="OnReviewTileChanging" AutomationProperties.Name="Média v koši galerie">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                    </GridView>
                    <Canvas IsHitTestVisible="False">
                        <Rectangle x:Name="TrashSelectionRectangle" Style="{StaticResource MarqueeOutlineStyle}" />
                    </Canvas>
                </Grid>
            </Grid>
        </Grid>

    </Grid>
        <Border Grid.Row="1" Padding="16,8" BorderThickness="0,1,0,0" Style="{StaticResource GallerySurfaceStyle}">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                     <TextBlock Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind ViewModel.IsGalleryOpen, Mode=OneWay}"
                                Style="{StaticResource GallerySecondaryTextStyle}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                Visibility="{x:Bind ViewModel.HasDisplayedLibrary, Mode=OneWay}">
                        <TextBlock Text="Celkem" Style="{StaticResource GallerySecondaryTextStyle}"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="3" ToolTipService.ToolTip="Celkový počet fotografií">
                            <Viewbox Width="14" Height="14">
                                <SymbolIcon Symbol="Pictures" />
                            </Viewbox>
                            <TextBlock Text="{x:Bind ViewModel.RootFolder.PhotoCount, Mode=OneWay}" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="3" ToolTipService.ToolTip="Celkový počet videí">
                            <Viewbox Width="14" Height="14">
                                <SymbolIcon Symbol="Video" />
                            </Viewbox>
                            <TextBlock Text="{x:Bind ViewModel.RootFolder.VideoCount, Mode=OneWay}" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.SelectionLabel, Mode=OneWay}"
                               Style="{StaticResource GallerySecondaryTextStyle}" />
                     <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.AnalysisSummary, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsGalleryOpen, Mode=OneWay}"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                </Grid>
                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               Style="{StaticResource GallerySecondaryTextStyle}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               ToolTipService.ToolTip="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                    <ProgressBar Grid.Column="1" Width="136" VerticalAlignment="Center" Maximum="100"
                                 Visibility="{x:Bind ViewModel.GalleryWorkActive, Mode=OneWay}"
                                 Value="{x:Bind ViewModel.GalleryWorkProgress, Mode=OneWay}"
                                  AutomationProperties.Name="Průběh práce v galerii" />
                 </Grid>
                 <Grid x:Name="PhotoProgressBanner" Grid.Row="2" Visibility="Collapsed" ColumnSpacing="10">
                     <Grid.ColumnDefinitions>
                         <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                         <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                     </Grid.ColumnDefinitions>
                     <TextBlock x:Name="PhotoFilePercent" />
                     <ProgressBar x:Name="PhotoFileProgress" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="Průběh souboru" />
                     <TextBlock x:Name="PhotoBatchPercent" Grid.Column="2" />
                     <ProgressBar x:Name="PhotoBatchProgress" Grid.Column="3" VerticalAlignment="Center" AutomationProperties.Name="Průběh celé úlohy" />
                 </Grid>
            </Grid>
        </Border>
        <Grid x:Name="PhotoViewer" Visibility="Collapsed" TabFocusNavigation="Cycle"
              Style="{StaticResource GalleryWorkspaceStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Padding="12,8" Style="{StaticResource GallerySurfaceStyle}" BorderThickness="0,0,0,1">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PreviewName" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                        <TextBlock x:Name="PreviewStatus" TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource GallerySecondaryTextStyle}"
                                   ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="Zastavit analýzu" Click="OnCancelGalleryWorkClick"
                                Visibility="{x:Bind ViewModel.GalleryWorkActive, Mode=OneWay}" />
                         <Button x:Name="PhotoConvertButton" Content="Převést fotografii…" Visibility="Collapsed"
                                 Click="OnPhotoConvertClick" IsEnabled="{x:Bind ViewModel.CanChangeFilters, Mode=OneWay}" />
                         <Button x:Name="FitPreviewButton" Content="Přizpůsobit" Click="OnFitPreviewClick" />
                        <Button x:Name="ActualSizeButton" Content="100 %" Click="OnActualSizeClick" />
                        <Button x:Name="ClosePreviewButton" Content="Zavřít" Click="OnClosePreviewClick"
                                ToolTipService.ToolTip="Zavřít náhled (Esc)" />
                    </StackPanel>
                </Grid>
            </Border>
            <ScrollViewer x:Name="PhotoScroll" Grid.Row="1" HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                          SizeChanged="OnPreviewSizeChanged">
                <Image x:Name="PreviewImage" Stretch="Uniform" />
            </ScrollViewer>
        </Grid>
        <Grid x:Name="VideoViewer" Visibility="Collapsed" TabFocusNavigation="Cycle"
              Style="{StaticResource GalleryWorkspaceStyle}" KeyDown="OnVideoViewerKeyDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Padding="12,8" Style="{StaticResource GallerySurfaceStyle}" BorderThickness="0,0,0,1">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="VideoName" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                         <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                             <Button x:Name="NextVideoButton" Content="Další video" Click="OnNextVideoClick" />
                             <Button x:Name="VideoTrashButton" Content="Do koše…" Click="OnVideoTrashClick" />
                             <Button x:Name="VideoDeleteButton" Content="Trvale smazat…" Click="OnVideoDeleteClick" />
                             <Button x:Name="CloseVideoButton" Content="Zavřít" Click="OnCloseVideoClick" />
                         </StackPanel>
                    </Grid>
                    <TextBlock x:Name="VideoStatus" TextWrapping="Wrap" MaxLines="5" TextTrimming="CharacterEllipsis"
                               Style="{StaticResource GallerySecondaryTextStyle}"
                               ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <ProgressBar x:Name="VideoProgressBar" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="VideoInstallButton" Content="Stáhnout FFmpeg" Visibility="Collapsed"
                                Click="OnVideoInstallClick" />
                        <Button x:Name="VideoPlayButton" Content="Přehrát" Visibility="Collapsed" Click="OnVideoPlayClick" />
                        <Button x:Name="VideoExternalButton" Content="Přehrát ve FFplay" Visibility="Collapsed"
                                Click="OnVideoExternalClick" />
                        <Button x:Name="VideoConvertButton" Content="Převést video…" Visibility="Collapsed"
                                Click="OnVideoConvertClick" />
                        <Button x:Name="VideoCancelButton" Content="Zrušit" Visibility="Collapsed" Click="OnVideoCancelClick" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Image x:Name="VideoPoster" Grid.Row="1" Stretch="Uniform" IsHitTestVisible="False" />
            <ContentControl x:Name="VideoPlayerHost" Grid.Row="1" HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
        </Grid>
    </Grid>
</Page>
